# =============================================================
# .env.example — copy this to .env and fill in your values
# NEVER commit .env to source control
# =============================================================

# ── JWT ──
JWT_SECRET=change-me-to-a-long-random-base64-string-at-least-256-bits

# ── Database (production) ──
DATABASE_URL=jdbc:postgresql://postgres:5432/credit_management_db
DATABASE_USER=credit_user
DATABASE_PASSWORD=change-me-strong-password

# ── CORS ──
CORS_ORIGINS=http://localhost

# ── Spring Profile ──
SPRING_PROFILES_ACTIVE=prod
